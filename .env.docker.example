# Use with docker-compose.yml. Copy to .env.local.
DATABASE_URL=postgresql://enviropulse:enviropulse_local_only@localhost:5433/enviropulse
JWT_SECRET=replace-with-a-long-random-local-secret
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DEMO_MODE=true

# Google Citizen Portal. Authorized redirect URI:
#   http://localhost:4000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Gmail delivery. Use a Google App Password, never the account password.
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
DEMO_EMAIL_RECIPIENT=

# Background citizen weather monitor (runs in the API process).
CITIZEN_MONITOR_ENABLED=true
CITIZEN_MONITOR_INTERVAL_SECONDS=300
CITIZEN_MONITOR_MIN_SEVERITY=HIGH
CITIZEN_MONITOR_COOLDOWN_MINUTES=360
CITIZEN_MONITOR_MAX_RETRIES=5

# Critical environmental news monitor.
NEWS_MONITOR_ENABLED=true
NEWS_MONITOR_INTERVAL_SECONDS=900
NEWS_MONITOR_COOLDOWN_MINUTES=360
NEWS_MONITOR_MAX_ITEMS=3

# Optional trained ML inference service (see ml/README.md)
ML_SERVICE_URL=
ML_SERVICE_API_KEY=

DATA_GOV_IN_AIR_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# Live polling cadence (upstream values only change when providers publish)
LIVE_ENABLED=true
LIVE_WEATHER_INTERVAL_SECONDS=60
LIVE_AQI_INTERVAL_SECONDS=300
LIVE_AIR_QUALITY_INTERVAL_SECONDS=900
LIVE_SIMULATION_INTERVAL_SECONDS=60

# Optional comma-separated fallback vision models (used when the primary model is unavailable)
VISION_FALLBACK_MODELS=
