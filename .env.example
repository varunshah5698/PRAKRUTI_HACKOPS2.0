# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# Database (PostgreSQL 16 + PostGIS 3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enviropulse

# Authentication
JWT_SECRET=change-me-local-dev-only-please-use-32-plus-chars
SESSION_SECRET=change-me-local-dev-only-please-use-32-plus-chars

# Google OpenID Connect (Citizen Portal). Register this exact redirect URI:
#   http://localhost:4100/api/v1/auth/google/callback
# or set GOOGLE_REDIRECT_URI explicitly for another host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# River AI (server-side only). Leave API key empty to run in NOT_CONFIGURED mode.
RIVER_BASE_URL=https://api.river.ai/v1
RIVER_MODEL=zai-org/GLM-5.3-Flash
RIVER_API_KEY=
# Maximum characters of evidence JSON sent to the model. Raise only if the model context supports it.
AI_EVIDENCE_CHAR_LIMIT=120000

# Vision provider (OpenAI-compatible). This workspace uses Groq's Qwen vision model.
# Leave VISION_API_KEY empty for NOT_CONFIGURED.
VISION_BASE_URL=https://api.groq.com/openai/v1
VISION_MODEL=qwen/qwen3.8-27b
VISION_API_KEY=

# Environmental data
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_AIR_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
OPENAQ_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com

# Mapping
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_TILE_PROVIDER=OpenFreeMap (OpenMapTiles + OpenStreetMap)

# Email — filling SMTP_USER and SMTP_PASSWORD enables real delivery.
# Gmail: set EMAIL_PROVIDER=gmail and use a Google App Password (not the account password).
#   Google Account → Security → 2-Step Verification → App passwords → "Mail".
# Critical alerts are broadcast to every ACTIVE account, not only opt-in subscribers.
EMAIL_PROVIDER=console        # console | gmail | smtp
EMAIL_API_KEY=
SMTP_HOST=                    # only needed for generic SMTP; ignored when EMAIL_PROVIDER=gmail
SMTP_PORT=587
SMTP_SECURE=false             # true for port 465 (Gmail)
SMTP_USER=                    # Gmail address, e.g. your.name@gmail.com
SMTP_PASSWORD=                # Gmail App Password (16 characters)
EMAIL_FROM=प्रकृति <alerts@enviropulse.local>   # falls back to SMTP_USER when Gmail is used
EMAIL_WEBHOOK_SECRET=

# Evidence storage (local-private adapter by default; S3-compatible adapter is a documented extension point)
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Demo
DEMO_MODE=true
DEMO_EMAIL_RECIPIENT=

# Optional trained ML inference service (see ml/README.md)
ML_SERVICE_URL=
ML_SERVICE_API_KEY=

# Live polling cadence (upstream values only change when providers publish)
LIVE_ENABLED=true
LIVE_WEATHER_INTERVAL_SECONDS=60
LIVE_AQI_INTERVAL_SECONDS=300
LIVE_AIR_QUALITY_INTERVAL_SECONDS=900
LIVE_SIMULATION_INTERVAL_SECONDS=60

# Citizen weather monitor. Runs in the API process and reads PostgreSQL; it does
# not depend on a browser session. On hosts that suspend idle web services the
# worker stops while suspended, so use an always-on instance for real alerts.
CITIZEN_MONITOR_ENABLED=true
CITIZEN_MONITOR_INTERVAL_SECONDS=300
CITIZEN_MONITOR_MIN_SEVERITY=HIGH
CITIZEN_MONITOR_COOLDOWN_MINUTES=360
CITIZEN_MONITOR_MAX_RETRIES=5

# Critical environmental news monitor. Reuses the same Gmail transport.
NEWS_MONITOR_ENABLED=true
NEWS_MONITOR_INTERVAL_SECONDS=900
NEWS_MONITOR_COOLDOWN_MINUTES=360
NEWS_MONITOR_MAX_ITEMS=3

# Optional comma-separated fallback vision models (used when the primary model is unavailable)
# A River-hosted fallback reuses RIVER_API_KEY; other providers need VISION_FALLBACK_API_KEY.
# VISION_FALLBACK_MODELS=moonshotai/Kimi-K3,zai-org/GLM-5.3-Flash
# VISION_FALLBACK_BASE_URL=https://api.river.ai/v1
# VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODELS=
